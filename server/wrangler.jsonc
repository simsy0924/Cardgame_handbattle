{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "handbattle-game-server",
  "main": "src/index.js",
  "compatibility_date": "2026-10-01",
  "workers_dev": true,
  "durable_objects": {
    "bindings": [
      {
        "name": "ROOMS",
        "class_name": "Room"
      }
    ]
  },
  "exports": {
    "Room": {
      "type": "durable-object",
      "storage": "sqlite"
    }
  },
  "vars": {
    "FIREBASE_PROJECT_ID": "cardgame-1b151"
  }
}
